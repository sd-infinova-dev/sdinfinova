{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sdinfinova",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "pages_build_output_dir": "dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sdinfinova-db",
      "database_id": "aa781be1-bbbd-4cce-aba3-61f910e9b68d"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "sdinfinova-media"
    }
  ]
}