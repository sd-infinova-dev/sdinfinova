# Runtime
NODE_ENV=development
PORT=3000
PGLITE_IN_MEMORY=false
# Production requires absolute paths to pre-mounted, existing persistent volumes.
# Relative defaults are for local development only.
PGLITE_DATA_DIR=./data/postgres
UPLOADS_DIR=./public/uploads

# Initial account bootstrap. Set once on a new/legacy installation, then remove.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-secret-at-least-16-characters

# Production origin/security configuration. Use the exact HTTPS site origin.
PUBLIC_ORIGIN=https://example.com
CORS_WHITELIST=https://example.com
TRUST_PROXY_HOPS=1
# Optional development-only iframe preview origins; never set for production.
DEV_PREVIEW_ORIGINS=
# Production database startup requires explicit authorization before PGlite opens.
# Keep true in production; use false to fail closed before database initialization.
ALLOW_SCHEMA_MIGRATIONS=false

# Inquiry notifications (optional; configure with a provider sandbox first)
NOTIFICATION_EMAIL=inquiries@example.com
SMTP_FROM=SD Infinova Inquiries <inquiries@example.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=inquiries@example.com
SMTP_PASS=replace-with-provider-secret
WHATSAPP_NUMBER=0000000000

# Optional integrations
GEMINI_API_KEY=replace-with-provider-key

# -------------------------------------------------------------
# Cloudflare Pages & Workers Environment Variables
# (Set in Cloudflare Dashboard -> Workers & Pages -> Settings -> Environment Variables)
# -------------------------------------------------------------
# PUBLIC_ORIGIN=https://<your-project>.pages.dev
# CORS_WHITELIST=https://<your-project>.pages.dev
# NOTIFICATION_EMAIL=sd.infinova@gmail.com
# WHATSAPP_NUMBER=9779800000000
# RESEND_API_KEY=re_your_api_key_here
